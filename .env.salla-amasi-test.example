# Explicit research mode only: --environment amasi-test-orders.
# Populate outside Git. No plaintext provider token is accepted.
SALLA_AMASI_TEST_STORE_ID=
# Exact non-Demo type observed from Store Information; do not guess its value.
SALLA_AMASI_TEST_STORE_TYPE=
SALLA_AMASI_TEST_TOKEN_SCOPES=orders.read_write,products.read,shipping.read
SALLA_AMASI_TEST_MANIFEST=
SALLA_AMASI_TEST_EVIDENCE_DIR=
SALLA_AMASI_TEST_RUN_WRITES=false
MONGO_URL=
DB_NAME=
# Existing single-operation review metadata (five-minute approval lifetime).
SALLA_P0_WRITE_APPROVAL_ID=
SALLA_P0_WRITE_APPROVAL_ISSUED_AT=
