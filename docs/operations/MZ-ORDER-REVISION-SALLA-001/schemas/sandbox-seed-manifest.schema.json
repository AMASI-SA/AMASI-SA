{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mezan.invalid/schemas/MZ-ORDER-REVISION-SALLA-001/sandbox-seed-manifest.schema.json",
  "title": "MZ-ORDER-REVISION-SALLA-001 Sandbox Seed Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "store_id", "orders", "products"],
  "properties": {
    "classification": {"const": "SANDBOX_SEED_MANIFEST"},
    "store_id": {"$ref": "#/$defs/id"},
    "orders": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/order"}
    },
    "products": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/product"}
    }
  },
  "$defs": {
    "id": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "integer"}
      ]
    },
    "idArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "optionValueTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id"],
      "properties": {
        "option_id": {"$ref": "#/$defs/id"},
        "value_id": {"$ref": "#/$defs/id"},
        "value_kind": {"const": "text"}
      },
      "oneOf": [
        {"required": ["value_id"], "not": {"required": ["value_kind"]}},
        {"required": ["value_kind"], "not": {"required": ["value_id"]}}
      ]
    },
    "variantTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "variant_id", "sku", "option_value_tuples"],
      "properties": {
        "product_id": {"$ref": "#/$defs/id"},
        "variant_id": {"$ref": "#/$defs/id"},
        "sku": {"type": "string", "minLength": 1},
        "option_value_tuples": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/optionValueTuple"}
        }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "order_id", "order_number", "item_id", "product_id", "sku", "payment_method", "branch_id"],
      "properties": {
        "state": {"enum": ["pending", "under_review", "in_progress", "paid", "partially_paid", "completed", "cancelled"]},
        "order_id": {"$ref": "#/$defs/id"},
        "order_number": {"$ref": "#/$defs/id"},
        "item_id": {"$ref": "#/$defs/id"},
        "product_id": {"$ref": "#/$defs/id"},
        "sku": {"type": "string", "minLength": 1},
        "payment_method": {"type": "string", "minLength": 1},
        "branch_id": {"$ref": "#/$defs/id"}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "product_id", "sku"],
      "properties": {
        "kind": {"enum": ["simple", "size_color_variant", "text_option", "checkbox_yes_no", "multi_quantity", "replacement"]},
        "product_id": {"$ref": "#/$defs/id"},
        "sku": {"type": "string", "minLength": 1},
        "branch_id": {"$ref": "#/$defs/id"},
        "unit_price": {"type": "number"},
        "inventory_quantity": {"type": "integer", "minimum": 0},
        "required": {"type": "boolean"},
        "max_length": {"type": "integer", "minimum": 1},
        "variant_ids": {"$ref": "#/$defs/idArray"},
        "option_ids": {"$ref": "#/$defs/idArray"},
        "value_ids": {"$ref": "#/$defs/idArray"},
        "option_value_tuples": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/optionValueTuple"}
        },
        "variant_tuples": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/variantTuple"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "size_color_variant"}}, "required": ["kind"]},
          "then": {"required": ["branch_id", "variant_ids", "option_ids", "value_ids", "option_value_tuples", "variant_tuples"]}
        },
        {
          "if": {"properties": {"kind": {"const": "text_option"}}, "required": ["kind"]},
          "then": {"required": ["option_ids", "option_value_tuples"]}
        },
        {
          "if": {"properties": {"kind": {"const": "checkbox_yes_no"}}, "required": ["kind"]},
          "then": {"required": ["option_ids", "value_ids", "option_value_tuples"]}
        }
      ]
    }
  }
}
