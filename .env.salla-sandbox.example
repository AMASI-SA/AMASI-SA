# P0 research runner only. Never put real credentials in Git.
SALLA_SANDBOX_BASE_URL=
SALLA_DEMO_STORE_ID=
SALLA_DEMO_TOKEN_SCOPES=orders.read_write,products.read_write
SALLA_SANDBOX_SEED_MANIFEST=
SALLA_SANDBOX_EVIDENCE_DIR=

# Replay/approval/order-lock state is not configurable and is never placed in
# the evidence directory. The Linux/POSIX-only CLI uses the resolved Git common
# directory's owner-only mz-p0-local-state/MZ-ORDER-REVISION-SALLA-001 path, so
# linked worktrees share it. Preserve it on this clone/host; it is local
# protection, not a global or cross-host ledger.

# Reuse the encrypted Salla credential through
# salla_integration.service.ensure_fresh_access_token. Never copy a token here.
MONGO_URL=
DB_NAME=

# Demo identity, write enablement, and one-time approval are all required.
# Destructive retry is a separate gate.
SALLA_DEMO_STORE_CONFIRMED=false
SALLA_SANDBOX_RUN_WRITES=false
SALLA_DEMO_ALLOW_DESTRUCTIVE_RETRY=false

# One-time P0 approval, issued immediately before one reviewed case. The CLI
# accepts it for five minutes, atomically reserves it before an attempt lease,
# and binds it to one local operation. The sealed write capability is rechecked
# immediately before every attempt/retry. This is authorization metadata, never
# a Salla credential.
SALLA_P0_WRITE_APPROVAL_ID=
SALLA_P0_WRITE_APPROVAL_ISSUED_AT=
