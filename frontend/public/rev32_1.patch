+            "action":          action,
+            "payment_method":  payment_method,
+            "client_repr":     client_repr,
+            "user_id":         user_id,
+            "db_present":      bool(db),
+            "row_id_present":  bool(row_id),
+            "trace_id":        trace_id,
+            "checked_at":      _now_iso(),
