+
+async def assert_client_write_permitted(
+    *,
+    db=None,
+    row_id: Optional[str] = None,
+    trace_id: Optional[str] = None,
+    user_id: str = "main",
+    action: str,
+    payment_method: Optional[str] = None,
+    allow_writes_without_row: bool = False,
+    client_repr: Optional[str] = None,
