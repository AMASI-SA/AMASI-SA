+        client = QoyodAPIClient(
+            "fake-key",
+            db=db, user_id="main",
+            row_id="row-270589798",
+            trace_id="9d9414fc29344076896beadb70cafc0b",
+        )
+        method = getattr(client, method_name)
+        with pytest.raises(Rev32Violation) as exc_info:
+            await method({}, idem="fake")
